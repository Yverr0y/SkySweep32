  "requirements": {
    "passive_rf": {
      "sub_ghz": "855-925 MHz channelized RSSI/activity observation with E07-900M10S; no 433 MHz operation",
      "two_point_four_ghz": "nRF24L01+ one-bit RPD energy observation plus ESP32 Wi-Fi/BLE receive functions; not protocol identity",
      "five_point_eight_ghz": "not implemented in Rev C; no stable exact RX5808 MPN is accepted",
      "remote_id": "experimental BLE/Wi-Fi receive software; no standards-conformance claim"
    },
    "ui": "Adafruit PID 326 SSD1306 OLED on keyed removable JST-PH harness, status LED, user button, buzzer and optional vibration motor",
    "storage": "removable microSD in exact Molex 104031-0811 socket on dedicated SPI bus",
    "position": "u-blox SAM-M10Q-00B GNSS module, UART NMEA and optional TIMEPULSE",
    "networking": "ESP32 Wi-Fi dashboard and ESP-NOW only; no canonical LoRa radio",
    "power": "5 V USB-C source rated at least 2 A; no battery charger and no battery on Rev C",
    "programming": "ESP32-S3 native USB, manual BOOT/RESET, labelled UART0/test pads",
    "enclosure": "indoor portable two-part printed enclosure; not sealed and not IP rated",
    "assembly": "four-layer assembled PCB with replaceable E01 module and lid-mounted OLED harness"
  },
  "excluded": [
    "RX5808 or other provisional 5.8 GHz receiver",
    "LoRa radio",
    "TinyML model inference",
    "direction finding",
    "battery charging",
    "active countermeasures or jamming outputs"
